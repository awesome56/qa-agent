# core
APP_ENV=prod
PORT=8000
SECRET_TOKEN=change-me-generate-with-openssl-rand-hex-32
TARGET_URL_DEFAULT=https://example.com

# public domain — served via Caddy on Lenovo
DOMAIN=qa.awesometech.com.ng
PUBLIC_URL=https://qa.awesometech.com.ng
CORS_ORIGINS=https://qa.awesometech.com.ng,https://awesometech.com.ng,http://localhost:3000

# storage
STORAGE_DIR=/app/storage

# redis / queue
REDIS_URL=redis://redis:6379/0

# qdrant / neo4j (optional, graceful fallback to in-memory if not set)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qa-agent-pass-change-me

# openai / rag (optional)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# github webhook — set in GitHub repo Settings -> Webhooks -> https://qa.awesometech.com.ng/webhook/github
GITHUB_WEBHOOK_SECRET=change-me-too-generate-with-openssl-rand-hex-32

# ghcr (for Lenovo pull) — private image
GHCR_PAT=
GHCR_USER=awesome56
TAG=closed

# caddy — no extra env needed, auto HTTPS via Let's Encrypt
